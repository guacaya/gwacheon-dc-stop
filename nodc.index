            build: buildMoland
        },
        gwacheon: {
            btnId: 'btnModeGwacheon',
            meta: '📍 접수 기관: 과천시 (시장)',
            target: 'epeople',
            goLabel: '🏛️ 국민신문고 바로가기 →',
            stickyLabel: '🏛️<br>신문고이동',
            titlePrefix: '민원 제목',
            reroll: rerollGwacheon,
            build: buildGwacheon
        },
        kepco: {
            btnId: 'btnModeKepco',
            meta: '📍 접수 기관: 한국전력공사',
            target: 'epeople',
            goLabel: '🏛️ 국민신문고 바로가기 →',
            stickyLabel: '🏛️<br>신문고이동',
            titlePrefix: '민원 제목',
            reroll: rerollKepco,
            build: buildKepco
        },
        fire: {
            btnId: 'btnModeFire',
            meta: '📍 접수 기관: 과천소방서 · ✨ 매번 두 버전(현장검토 요청 / 부동의 촉구) 중 하나가 무작위로 나옵니다',
            target: 'epeople',
            goLabel: '🏛️ 국민신문고 바로가기 →',
            stickyLabel: '🏛️<br>신문고이동',
            titlePrefix: '민원 제목',
            reroll: rerollFire,
            build: buildFire
        },
        budongsan: {
            btnId: 'btnModeBudongsan',
            meta: '📍 접수 기관: 한국부동산원 (리츠심사팀) · ✨ 매번 다른 문장으로 자동 다변화됩니다',
            target: 'epeople',
            goLabel: '🏛️ 국민신문고 바로가기 →',
            stickyLabel: '🏛️<br>신문고이동',
            titlePrefix: '민원 제목',
            reroll: rerollBudongsan,
            build: buildBudongsan
        }
    };

    /* ===================== 기관별 제출 완료 체크 ===================== */
    // 6개 기관 중 어디에 이미 제출했는지 이 브라우저에 기억해두고, 완료 표시된 기관은 탭을 딤 처리합니다.
    const AGENCY_DONE_KEY = 'gwacheon_agency_done_v1';
    function loadAgencyDone() {
        try { return new Set(JSON.parse(localStorage.getItem(AGENCY_DONE_KEY) || '[]')); }
        catch (e) { return new Set(); }
    }
    function saveAgencyDone(set) {
        try { localStorage.setItem(AGENCY_DONE_KEY, JSON.stringify([...set])); } catch (e) {}
    }
    let agencyDone = loadAgencyDone();

    function toggleAgencyDone(mode) {
        if (agencyDone.has(mode)) { agencyDone.delete(mode); } else { agencyDone.add(mode); }
        saveAgencyDone(agencyDone);
        renderAgencyDoneUI();
    }

    function renderAgencyDoneUI() {
        const modes = Object.keys(MODE_CONFIG);
        modes.forEach(m => {
            const done = agencyDone.has(m);
            const btn = document.getElementById(MODE_CONFIG[m].btnId);
            const check = document.getElementById('agencyCheck_' + m);
            if (btn) btn.classList.toggle('agency-done', done);
            if (check) {
                check.classList.toggle('done', done);
                check.textContent = done ? '✅' : '☐';
                check.setAttribute('aria-checked', done ? 'true' : 'false');
            }
        });
        const total = modes.length;
        const doneCount = modes.filter(m => agencyDone.has(m)).length;
        const countEl = document.getElementById('agencyProgressText');
        if (countEl) countEl.textContent = `${doneCount} / ${total}개 기관 제출 완료`;
        const fillEl = document.getElementById('agencyProgressFill');
        if (fillEl) fillEl.style.width = (total ? (doneCount / total * 100) : 0) + '%';
    }

    // 제목/본문을 둘 다 복사했거나(또는 "제목+본문 한번에 복사"를 눌렀으면) 그 기관은 자동으로 제출 완료 처리합니다.
    // (직접 국민신문고에 제출을 완료했다는 뜻은 아니지만, 복사=제출 직전 단계라 자동 체크 신호로 사용합니다. 틀렸으면 체크를 다시 눌러 해제할 수 있어요.)
    const AGENCY_LABELS = { lh: 'LH', moland: '국토교통부', gwacheon: '과천시', kepco: '한국전력', fire: '과천소방서', budongsan: '부동산원' };
    const copiedParts = {};
    function markCopied(part) {
        const m = currentMode;
        if (!copiedParts[m]) copiedParts[m] = {};
        copiedParts[m][part] = true;
        const p = copiedParts[m];
        if (!agencyDone.has(m) && (p.all || (p.title && p.body))) {
            agencyDone.add(m);
            saveAgencyDone(agencyDone);
            renderAgencyDoneUI();
            showToast(`✅ ${AGENCY_LABELS[m] || ''} 민원 제출완료로 자동 체크했어요!\n실수라면 탭의 체크 표시를 눌러 해제할 수 있어요.`);
        }
    }

    function switchMode(mode) {
        currentMode = mode;
        Object.keys(MODE_CONFIG).forEach(m => {
            document.getElementById(MODE_CONFIG[m].btnId).classList.toggle('active', m === mode);
        });

        const cfg = MODE_CONFIG[mode];
        const meta = document.getElementById('metaInfoLine');
        const goBtn = document.getElementById('btnGoTarget');
        const stickyBtn = document.getElementById('stickyBtnTarget');

        meta.innerText = cfg.meta;
        goBtn.innerText = cfg.goLabel;
        stickyBtn.innerHTML = cfg.stickyLabel;
        goBtn.href = EPEOPLE_URL;
        stickyBtn.href = EPEOPLE_URL;

        generate(true);
    }

    function generate(reroll) {
        const cfg = MODE_CONFIG[currentMode];
        if (reroll) cfg.reroll();
        const r = cfg.build();
        currentTitle = r.title;
        document.getElementById('titleDisplay').innerText = `${cfg.titlePrefix}: ${r.title}`;
        document.getElementById('resultBox').value = r.body;
        document.getElementById('btnGoTarget').href = EPEOPLE_URL;
        document.getElementById('stickyBtnTarget').href = EPEOPLE_URL;
        resetCopyButtons();
        updatePersonalizeGateUI();
    }

    function onInputsChanged() { generate(false); }

    /* ===================== 개인화 필수 처리 ===================== */
    function isPersonalized() {
        return selectedKeywords.size > 0 || document.getElementById('freeformInput').value.trim().length > 0;
    }

    function updatePersonalizeGateUI() {
        const ok = isPersonalized();
        ['btnCopyTitle', 'btnCopyBody', 'btnCopyAll', 'btnGoTarget', 'stickyBtnTitle', 'stickyBtnBody', 'stickyBtnAll', 'stickyBtnTarget'].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.classList.toggle('gate-locked', !ok);
        });
        const note = document.getElementById('personalizeRequiredNote');
        if (!note) return;
        if (ok) {
            note.innerText = '✅ 준비 완료! 이제 제목·본문 복사와 신문고 이동이 가능해요.';
            note.style.color = '#15803d';
        } else {
            note.innerText = '⚠️ 최소 1개 이상 선택하거나 직접 사연을 적어야 복사·제출이 가능해요.';
            note.style.color = '#dc2626';
        }
    }

    function checkPersonalized() {
        if (isPersonalized()) return true;
        showToast('⚠️ 먼저 나만의 이유를 선택하거나 적어주세요!');
        const box = document.querySelector('.personalize-box');
        if (box) {
            box.scrollIntoView({ behavior: 'smooth', block: 'center' });
            box.classList.add('flash-required');
            setTimeout(() => box.classList.remove('flash-required'), 1200);
        }
        return false;
    }

    function resetCopyButtons() {
        const t = document.getElementById('btnCopyTitle');
        const b = document.getElementById('btnCopyBody');
        const a = document.getElementById('btnCopyAll');
        if (t) { t.classList.remove('copied'); t.innerHTML = '📋 제목만 복사'; }
        if (b) { b.classList.remove('copied'); b.innerHTML = '📄 본문만 복사'; }
        if (a) { a.classList.remove('copied'); a.innerHTML = '📋 제목+본문 한번에 복사'; }
    }

    function copyTitle() {
        navigator.clipboard.writeText(currentTitle).then(() => {
            const btn = document.getElementById('btnCopyTitle');
            btn.classList.add('copied'); btn.innerHTML = '✅ 복사됨!';
            showToast('📋 제목이 복사됐어요!');
            setTimeout(() => { btn.classList.remove('copied'); btn.innerHTML = '📋 제목만 복사'; }, 1800);
            markCopied('title');
        });
    }

    function copyBody() {
        const body = document.getElementById('resultBox').value;
        navigator.clipboard.writeText(body).then(() => {
            const btn = document.getElementById('btnCopyBody');
            btn.classList.add('copied'); btn.innerHTML = '✅ 복사됨!';
            showToast('📄 본문이 복사됐어요!');
            setTimeout(() => { btn.classList.remove('copied'); btn.innerHTML = '📄 본문만 복사'; }, 1800);
            markCopied('body');
        });
    }

    function copyAll() {
        const body = document.getElementById('resultBox').value;
        const full = `[제목]\n${currentTitle}\n\n[본문]\n${body}`;
        navigator.clipboard.writeText(full).then(() => {
            const btn = document.getElementById('btnCopyAll');
            btn.classList.add('copied'); btn.innerHTML = '✅ 복사됨!';
            showToast('📋 제목+본문이 모두 복사됐어요!');
            setTimeout(() => { btn.classList.remove('copied'); btn.innerHTML = '📋 제목+본문 한번에 복사'; }, 1800);
            markCopied('all');
        });
    }

    function showToast(msg) {
        const t = document.getElementById('toastMsg');
        t.innerText = msg;
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 2800);
    }

    /* ===================== 상단 탭 전환 (작성 ⇄ 문자 보내기) ===================== */
    function switchTopTab(tab) {
        const btnWrite = document.getElementById('topTabWrite');
        const btnSms = document.getElementById('topTabAction');
        const panelWrite = document.getElementById('panelWrite');
        const panelSms = document.getElementById('panelSms');
        if (tab === 'sms') {
            btnWrite.classList.remove('active'); btnSms.classList.add('active');
            panelWrite.classList.remove('active'); panelSms.classList.add('active');
        } else {
            btnWrite.classList.add('active'); btnSms.classList.remove('active');
            panelWrite.classList.add('active'); panelSms.classList.remove('active');
        }
        updateStickyOffset();
    }

    /* ===================== 이용 방법 가이드 접기/펼치기 ===================== */
    // 처음 방문(이 브라우저에서 처음 여는 경우)이면 펼친 상태로 보여주고,
    // 재방문이면 접어서 모바일에서 화면을 덜 차지하도록 합니다. 언제든 눌러서 다시 펼 수 있습니다.
    const USAGE_GUIDE_SEEN_KEY = 'juam_usage_guide_seen_v1';
    function initUsageGuide() {
        const box = document.getElementById('usageGuideBox');
        if (!box) return;
        let seenBefore = false;
        try { seenBefore = localStorage.getItem(USAGE_GUIDE_SEEN_KEY) === '1'; } catch (e) {}
        if (seenBefore) {
            box.classList.add('collapsed');
        } else {
            try { localStorage.setItem(USAGE_GUIDE_SEEN_KEY, '1'); } catch (e) {}
        }
        updateUsageGuideArrow();
    }
    function toggleUsageGuide() {
        const box = document.getElementById('usageGuideBox');
        if (!box) return;
        box.classList.toggle('collapsed');
        updateUsageGuideArrow();
    }
    function updateUsageGuideArrow() {
        const box = document.getElementById('usageGuideBox');
        const arrow = document.getElementById('usageGuideArrow');
        const toggleBtn = document.getElementById('usageGuideToggle');
        if (!box || !arrow) return;
        const collapsed = box.classList.contains('collapsed');
        arrow.textContent = collapsed ? '▼' : '▲';
        if (toggleBtn) toggleBtn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
    }

    // 모바일에서 가이드 박스를 위로 스와이프하면 접히고, 아래로 스와이프하면 펼쳐집니다.
    // 페이지 스크롤을 막지 않도록 preventDefault는 쓰지 않고, 짧고 확실한 수직 제스처만 감지합니다.
    function initUsageGuideSwipe() {
        const box = document.getElementById('usageGuideBox');
        if (!box) return;
        let startX = null, startY = null, startTime = 0;
        box.addEventListener('touchstart', (e) => {
            if (!e.touches || e.touches.length !== 1) { startY = null; return; }
            startX = e.touches[0].clientX;
            startY = e.touches[0].clientY;
            startTime = Date.now();
        }, { passive: true });
        box.addEventListener('touchend', (e) => {
            if (startY === null) return;
            const touch = e.changedTouches && e.changedTouches[0];
            const sX = startX, sY = startY, sTime = startTime;
            startX = null; startY = null;
            if (!touch) return;
            const deltaY = touch.clientY - sY;
            const deltaX = touch.clientX - sX;
            const elapsed = Date.now() - sTime;
            if (Math.abs(deltaX) > Math.abs(deltaY)) return; // 가로 스와이프는 무시
            if (elapsed > 700) return; // 너무 느리면 의도치 않은 드래그로 간주
            const collapsed = box.classList.contains('collapsed');
            if (!collapsed && deltaY < -45) {
                box.classList.add('collapsed');
                updateUsageGuideArrow();
            } else if (collapsed && deltaY > 45) {
                box.classList.remove('collapsed');
                updateUsageGuideArrow();
            }
        }, { passive: true });
    }

    // 상단 탭바 높이를 재서 "발송 현황" 바가 그 바로 아래에 겹치지 않고 고정되도록 맞춥니다.
    // (기기 폭/글자 줄바꿈에 따라 탭바 높이가 달라질 수 있어 고정값 대신 매번 측정합니다.)
    function updateStickyOffset() {
        const wrap = document.querySelector('.top-index-tabs-wrap');
        if (!wrap) return;
        document.documentElement.style.setProperty('--sms-sticky-offset', wrap.getBoundingClientRect().height + 'px');
    }
    window.addEventListener('resize', updateStickyOffset);
    window.addEventListener('orientationchange', updateStickyOffset);

    /* ===================== 모드 ③ 과천시의원 문자 보내기 ===================== */
    const COUNCIL_MEMBERS = [
        { id: 'ji',    party: 'ppp', name: '지태훈', phone: '010-4429-1766' },
        { id: 'hwang', party: 'ppp', name: '황선희', phone: '010-8227-5139' },
        { id: 'yoo',   party: 'ppp', name: '유부임', phone: '010-5186-8058' },
        { id: 'kimdj', party: 'ppp', name: '김동진', phone: '010-7933-7536' },
        { id: 'kimdh', party: 'ppp', name: '김동현', phone: '010-8826-6826' },
        { id: 'lee',   party: 'dp',  name: '이주연', phone: '010-9310-4087' },
        { id: 'choi',  party: 'dp',  name: '최지희', phone: '010-2661-4133' }
    ];

    // 완성된 문장을 통째로 불러오는 대신, 조합해서 직접 쓰도록 짧은 표현 조각만 제공합니다.
    const SMS_KEYWORDS = {
        ppp: [
            "조례 개정에 힘써주셔서 감사합니다.",
            "주민들의 불안과 우려가 한계에 다다랐습니다.",
            "일초가 다급한 사안이라고 생각합니다.",
            "실질적인 보호 조치가 꼭 필요합니다.",
            "하루빨리 개정이 완료되길 부탁드립니다."
        ],
        dp: [
            "과천 주민의 안전이 심각한 위기에 직면해 있습니다.",
            "더는 지체할 시간이 없습니다.",
            "주민의 생명과 안전이 최우선입니다.",
            "조속한 조례 개정에 앞장서 주세요."
        ]
    };

    const SMS_SENT_KEY = 'gwacheon_sms_sent_v1';
    const SMS_SPLIT_LIMIT = 180; // 이 길이(자)를 넘으면 아이폰/갤럭시에서 잘리지 않도록 문자를 2건으로 나눕니다.

    function loadSmsSent() {
        try { return new Set(JSON.parse(localStorage.getItem(SMS_SENT_KEY) || '[]')); }
        catch (e) { return new Set(); }
    }
    function saveSmsSent(set) {
        try { localStorage.setItem(SMS_SENT_KEY, JSON.stringify([...set])); } catch (e) {}
    }
    let smsSent = loadSmsSent();

    function isIOS() {
        return /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
    }

    // 아이폰은 sms:번호&body=..., 갤럭시(안드로이드)는 sms:번호?body=... 형식을 사용해야 문자 앱에 내용이 정상적으로 채워집니다.
    function buildSmsHref(phone, body) {
        const sep = isIOS() ? '&' : '?';
        return `sms:${phone}${sep}body=${encodeURIComponent(body)}`;
    }

    // 문장이 길어지면(기본 180자 초과) 문자 앱에서 잘리지 않도록 자연스러운 위치에서 2건으로 나눕니다.
    function splitSmsBody(text) {
        const trimmed = text.trim();
        const chars = [...trimmed];
        if (chars.length <= SMS_SPLIT_LIMIT) return [trimmed];

        let cut = -1;
        for (let i = Math.max(Math.floor(chars.length / 2) - 25, 0); i < chars.length; i++) {
            if ('.!?\n'.includes(chars[i])) { cut = i + 1; break; }
        }
        if (cut === -1) {
            for (let i = Math.floor(chars.length / 2); i < chars.length; i++) {
                if (chars[i] === ' ') { cut = i + 1; break; }
            }
        }
        if (cut === -1) cut = Math.floor(chars.length / 2);

        const part1 = chars.slice(0, cut).join('').trim();
        const part2 = chars.slice(cut).join('').trim();
        return [`(1/2) ${part1}`, `(2/2) ${part2}`];
    }

    function buildSmsKeywordGrid(containerId, party) {
        const grid = document.getElementById(containerId);
        grid.innerHTML = '';
        SMS_KEYWORDS[party].forEach(text => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'keyword-chip';
            btn.innerText = text;
            btn.onclick = () => insertSmsKeyword(text, party);
            grid.appendChild(btn);
        });
    }

    // 클릭한 표현을 해당 정당 편집창 끝에 이어붙입니다(전체를 덮어쓰지 않음) — 직접 문장을 조합해서 쓰도록 돕는 용도입니다.
    function insertSmsKeyword(text, party) {
        const box = document.getElementById('smsComposeBox_' + party);
        let current = box.value;
        if (current && !/\s$/.test(current)) current += ' ';
        box.value = current + text;
        box.focus();
        box.selectionStart = box.selectionEnd = box.value.length;
        onSmsComposeChanged(party);
    }

    function clearSmsCompose(party) {
        const box = document.getElementById('smsComposeBox_' + party);
        box.value = '';
        onSmsComposeChanged(party);
        box.focus();
    }

    function onSmsComposeChanged(party) {
        const len = [...document.getElementById('smsComposeBox_' + party).value.trim()].length;
        const info = document.getElementById('smsCharInfo_' + party);
        if (len === 0) {
            info.innerText = '';
        } else if (len > SMS_SPLIT_LIMIT) {
            info.innerText = `현재 ${len}자 · 문자 앱에서 잘리지 않도록 2건으로 나눠 보내드려요.`;
            info.style.color = '#b45309';
        } else {
            info.innerText = `현재 ${len}자 · 문자 1건으로 보내드려요.`;
            info.style.color = '#64748b';
        }
        COUNCIL_MEMBERS.filter(m => m.party === party).forEach(renderSmsMemberActions);
    }

    function renderSmsMemberLists() {
        const listPpp = document.getElementById('smsListPpp');
        const listDp = document.getElementById('smsListDp');
        listPpp.innerHTML = '';
        listDp.innerHTML = '';

        COUNCIL_MEMBERS.forEach(m => {
            const target = m.party === 'ppp' ? listPpp : listDp;
            const row = document.createElement('div');
            row.className = 'sms-member-row' + (smsSent.has(m.id) ? ' sent' : '');
            row.id = 'smsRow_' + m.id;
            if (smsSent.has(m.id)) row.style.display = 'none'; // 이미 보낸 의원은 목록에서 바로 숨김

            const info = document.createElement('div');
            info.className = 'sms-member-info';
            info.innerHTML = `<span class="sms-member-name">${m.name} 의원</span><span class="sms-member-phone">${m.phone}</span>`;

            const actions = document.createElement('div');
            actions.className = 'sms-member-actions';
            actions.id = 'smsActions_' + m.id;

            const badge = document.createElement('span');
            badge.className = 'sms-sent-badge';
            badge.id = 'smsBadge_' + m.id;
            badge.innerText = smsSent.has(m.id) ? '✅ 발송완료' : '';

            row.appendChild(info);
            row.appendChild(actions);
            row.appendChild(badge);
            target.appendChild(row);

            renderSmsMemberActions(m);
        });
    }

    function renderSmsMemberActions(m) {
        const actions = document.getElementById('smsActions_' + m.id);
        if (!actions) return;
        actions.innerHTML = '';
        const box = document.getElementById('smsComposeBox_' + m.party);
        const body = box ? box.value.trim() : '';

        if (!body) {
            const hint = document.createElement('span');
            hint.className = 'sms-need-text-hint';
            hint.innerText = '문구를 먼저 준비해 주세요';
            actions.appendChild(hint);
            return;
        }

        const parts = splitSmsBody(body);
        parts.forEach((part, idx) => {
            const btn = document.createElement('a');
            btn.className = 'sms-send-btn';
            btn.href = buildSmsHref(m.phone, part);
            btn.innerText = parts.length > 1 ? `📱 문자 보내기 (${idx + 1}/2)` : '📱 문자 보내기';
            btn.onclick = () => { markSmsSent(m.id); };
            actions.appendChild(btn);
        });

        const copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'sms-copy-btn';
        copyBtn.innerText = '복사';
        copyBtn.onclick = () => {
            navigator.clipboard.writeText(parts.join('\n\n')).then(() => showToast('📱 문자 내용이 복사됐어요!'));
        };
        actions.appendChild(copyBtn);
    }

    function markSmsSent(id) {
        smsSent.add(id);
        saveSmsSent(smsSent);
        updateSmsStatus();
        const row = document.getElementById('smsRow_' + id);
        const badge = document.getElementById('smsBadge_' + id);
        if (badge) badge.innerText = '✅ 발송완료';
        if (row) {
            row.classList.add('sent'); // 먼저 딤 처리로 보낸 걸 알려주고
            setTimeout(() => { row.style.display = 'none'; }, 900); // 잠시 후 목록에서 숨김
        }
    }

    function updateSmsStatus() {
        const total = COUNCIL_MEMBERS.length;
        const done = COUNCIL_MEMBERS.filter(m => smsSent.has(m.id)).length;
        document.getElementById('smsStatusCount').innerText = `${done} / ${total}명 발송완료`;
        document.getElementById('smsProgressFill').style.width = `${Math.round(done / total * 100)}%`;
    }

    function resetSmsProgress() {
        if (!confirm('발송 기록을 모두 초기화할까요? (실제로 보낸 문자에는 영향이 없습니다)')) return;
        smsSent = new Set();
        saveSmsSent(smsSent);
        renderSmsMemberLists();
        updateSmsStatus();
    }

    function initSmsPanel() {
        buildSmsKeywordGrid('smsGuidePpp', 'ppp');
        buildSmsKeywordGrid('smsGuideDp', 'dp');
        renderSmsMemberLists();
        updateSmsStatus();
    }

    /* ===================== 초기화 ===================== */
    buildKeywordGrid();
    rerollBudongsan();
    rerollLh();
    rerollMoland();
    rerollGwacheon();
    rerollKepco();
    rerollFire();
    switchMode('lh');
    initSmsPanel();
    initUsageGuide();
    initUsageGuideSwipe();
    renderAgencyDoneUI();
    updateStickyOffset();
</script>
</body>
</html>
