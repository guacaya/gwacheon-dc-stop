<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>과천 주암 데이터센터 대응 민원·의견서 도우미</title>

    <meta name="theme-color" content="#3b5bdb">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="주암 민원·의견서">

    <style>
        :root {
            --primary-color: #3b5bdb;
            --primary-hover: #2f4ac7;
            --accent-color: #0d9488;
            --accent-hover: #0f766e;
            --bg-color: #f8fafc;
            --slate: #475569;
            --slate-hover: #334155;
            --lh-color: #7c3aed;
            --lh-hover: #6d28d9;
            --moland-color: #be123c;
            --moland-hover: #9f1239;
            --gwacheon-color: #ca8a04;
            --gwacheon-hover: #a16207;
            --kepco-color: #0369a1;
            --kepco-hover: #075985;
            --fire-color: #ea580c;
            --fire-hover: #c2410c;
            --sms-sticky-offset: 90px;
        }
        body { font-family: 'Malgun Gothic', 'Apple SD Gothic Neo', sans-serif; padding: 15px; line-height: 1.6; background-color: var(--bg-color); color: #334155; margin: 0; }
        .container { max-width: 750px; margin: 20px auto; background: white; padding: 25px; border-radius: 12px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); }
        h2 { text-align: center; color: #1e293b; margin-top: 0; margin-bottom: 5px; font-size: 20px; }
        p.desc { text-align: center; font-size: 14px; color: #64748b; margin-bottom: 22px; word-break: keep-all; }

        .guide-box { border: 1px solid #fed7aa; background-color: #fffbfe; border-radius: 8px; margin-bottom: 20px; overflow: hidden; }
        .guide-toggle { width: 100%; background: none; border: none; cursor: pointer; padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; font-family: inherit; }
        .guide-toggle-left { display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: bold; color: #c2410c; }
        .guide-toggle-arrow { font-size: 12px; color: #c2410c; transition: transform 0.3s; }
        .guide-box.open .guide-toggle-arrow { transform: rotate(180deg); }
        .guide-content { max-height: 0; overflow: hidden; transition: max-height 0.35s ease, padding 0.3s; padding: 0 20px; }
        .guide-box.open .guide-content { max-height: 1200px; padding: 0 20px 20px; }
        .guide-title { font-size: 15px; font-weight: bold; color: #c2410c; margin-top: 14px; margin-bottom: 12px; }
        .guide-title:first-child { margin-top: 0; }
        .guide-step ol { margin: 5px 0; padding-left: 20px; font-size: 14px; color: #475569; }
        .guide-step li { margin-bottom: 8px; }
        .strong-blue { color: #2563eb; font-weight: bold; }
        .strong-red { color: #dc2626; font-weight: bold; }
        .link-epeople { color: #2563eb; font-weight: bold; text-decoration: underline; }

        .usage-guide-box { background: linear-gradient(135deg, #fff7ed, #fffbeb); border: 2px solid #fdba74; border-radius: 10px; margin-bottom: 18px; overflow: hidden; }
        .usage-guide-toggle { width: 100%; background: none; border: none; cursor: pointer; padding: 14px 16px; display: flex; align-items: center; justify-content: space-between; gap: 10px; font-family: inherit; text-align: left; -webkit-tap-highlight-color: transparent; }
        .usage-guide-toggle-left { font-size: 15px; font-weight: 800; color: #c2410c; line-height: 1.4; }
        .usage-guide-arrow { font-size: 12px; color: #c2410c; flex-shrink: 0; }
        .usage-guide-swipe-handle { display: none; }
        .usage-guide-content { max-height: 2400px; opacity: 1; overflow: hidden; padding: 0 18px 16px; transition: max-height 0.35s ease, opacity 0.25s ease, padding 0.3s ease; }
        .usage-guide-box.collapsed .usage-guide-content { max-height: 0; opacity: 0; padding: 0 18px; }
        .usage-guide-steps { margin: 0 0 10px; padding-left: 20px; font-size: 13.5px; color: #7c2d12; line-height: 1.7; }
        .usage-guide-steps li { margin-bottom: 4px; }
        .usage-guide-note { font-size: 12px; font-weight: 700; color: #9a3412; background: #fff1e6; border-radius: 6px; padding: 8px 10px; line-height: 1.6; }
        .highlight-mark { background: #fecaca; color: #b91c1c; padding: 1px 5px; border-radius: 4px; }
        .usage-guide-screenshot-wrap { margin: 4px 0 10px; text-align: center; }
        .usage-guide-screenshot { max-width: 100%; height: auto; border: 1px solid #fdba74; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }

        .dong-input-box { background: #f1f5f9; padding: 12px 15px; border-radius: 8px; margin-bottom: 20px; border-left: 4px solid #2563eb; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .dong-input-box label { font-size: 13px; font-weight: bold; color: #334155; }
        .dong-input-box select { padding: 6px 8px; font-size: 13px; border: 1px solid #cbd5e1; border-radius: 6px; background-color: white; font-weight: bold; color: #334155; }
        .dong-input-box input { padding: 6px 8px; font-size: 13px; border: 1px solid #cbd5e1; border-radius: 6px; width: 56px; text-align: center; font-weight: bold; }
        .dong-notice { font-size: 12px; color: #64748b; width: 100%; margin-top: 5px; padding-left: 5px; }

        .section-divider { border: none; border-top: 1px dashed #cbd5e1; margin: 22px 0; }

        .personalize-box { background: #fdf4ff; border: 1px solid #e9d5ff; border-radius: 10px; padding: 16px 18px; margin-bottom: 20px; }
        .personalize-title { font-size: 14.5px; font-weight: 800; color: #7e22ce; margin-bottom: 10px; }
        .personalize-sub { font-size: 12px; color: #6b21a8; margin-bottom: 12px; }
        .keyword-grid { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
        .keyword-chip { padding: 9px 13px; font-size: 13px; font-weight: 600; border: 2px solid #d8b4fe; border-radius: 20px; background: white; color: #7e22ce; cursor: pointer; transition: 0.15s; }
        .keyword-chip:hover { background: #faf5ff; }
        .keyword-chip.active { background: #9333ea; border-color: #9333ea; color: white; }
        .freeform-label { font-size: 13px; font-weight: 700; color: #6b21a8; margin-bottom: 6px; display: block; }
        textarea.freeform-input { width: 100%; height: 70px; border: 1px solid #d8b4fe; border-radius: 8px; padding: 10px 12px; box-sizing: border-box; font-size: 13.5px; resize: vertical; background: white; font-family: inherit; color: #334155; }
        .personalize-required-note { font-size: 12px; font-weight: 700; margin-bottom: 12px; color: #dc2626; }
        .personalize-box.flash-required { animation: personalizeFlash 1.2s ease; }
        @keyframes personalizeFlash { 0%, 100% { box-shadow: none; } 30% { box-shadow: 0 0 0 4px rgba(220,38,38,0.35); } 60% { box-shadow: 0 0 0 2px rgba(220,38,38,0.2); } }
        .gate-locked { opacity: 0.45; filter: grayscale(35%); cursor: not-allowed; }
        /* PC 상단 복사바: 잠긴 상태를 흐림 필터 대신 또렷한 회색 "비활성" 스타일로 표시 (모바일 하단바와 동일한 처리) */
        .title-action-row .gate-locked {
            opacity: 1 !important; filter: none !important;
            background: #e2e8f0 !important; color: #94a3b8 !important;
            border-color: #cbd5e1 !important; box-shadow: none !important;
        }

        .mode-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 22px; border-bottom: 2px solid #e2e8f0; padding-bottom: 15px; }
        .mode-btn { position: relative; padding: 13px 8px; font-size: 14px; font-weight: bold; border: 2px solid #cbd5e1; border-radius: 8px; background: white; cursor: pointer; color: #64748b; transition: 0.2s; }
        .mode-btn.active.mode-budongsan { border-color: var(--primary-color); background-color: var(--primary-color); color: white; }
        .mode-btn.active.mode-lh { border-color: var(--lh-color); background-color: var(--lh-color); color: white; }
        .mode-btn.active.mode-moland { border-color: var(--moland-color); background-color: var(--moland-color); color: white; }
        .mode-btn.active.mode-gwacheon { border-color: var(--gwacheon-color); background-color: var(--gwacheon-color); color: white; }
        .mode-btn.active.mode-kepco { border-color: var(--kepco-color); background-color: var(--kepco-color); color: white; }
        .mode-btn.active.mode-fire { border-color: var(--fire-color); background-color: var(--fire-color); color: white; }
        .new-mode-badge { position: absolute; top: -9px; right: -6px; background: #dc2626; color: white; font-size: 9.5px; font-weight: 800; padding: 3px 7px; border-radius: 999px; box-shadow: 0 2px 6px rgba(220,38,38,0.5); }

        /* 기관별 제출 완료 체크 */
        .mode-complete-check {
            position: absolute; top: -10px; right: -8px; width: 25px; height: 25px; border-radius: 50%;
            background: white; border: 2px solid #cbd5e1; display: flex; align-items: center; justify-content: center;
            font-size: 13px; line-height: 1; cursor: pointer; z-index: 3; color: #94a3b8;
            box-shadow: 0 2px 6px rgba(0,0,0,0.15); transition: 0.15s;
        }
        .mode-complete-check:hover { border-color: #16a34a; color: #16a34a; }
        .mode-complete-check.done { background: #16a34a; border-color: #16a34a; color: white; }
        .mode-btn.agency-done { opacity: 0.55; filter: grayscale(55%); }
        .agency-progress-box { background: #f0fdfa; border: 1px solid #99f6e4; border-radius: 10px; padding: 12px 16px; margin-bottom: 18px; }
        .agency-progress-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; gap: 8px; }
        .agency-progress-label { font-size: 13px; font-weight: 800; color: #0f766e; }
        .agency-progress-count { font-size: 13px; font-weight: 800; color: #0f766e; white-space: nowrap; }
        .agency-progress-track { background: #ccfbf1; border-radius: 999px; height: 10px; overflow: hidden; }
        .agency-progress-fill { background: linear-gradient(90deg, #14b8a6, #0d9488); height: 100%; border-radius: 999px; transition: width 0.3s; }
        .agency-progress-hint { font-size: 11.5px; color: #0f766e; margin-top: 8px; line-height: 1.5; }

        .meta-info { font-size: 13px; font-weight: bold; color: #0f172a; margin-bottom: 8px; background: #f1f5f9; padding: 10px 14px; border-radius: 6px; }
        .title-row { margin-bottom: 0; }
        .title-box { background: #eef2ff; border-left: 4px solid var(--primary-color); padding: 10px 14px; font-weight: bold; font-size: 14px; color: #3730a3; border-radius: 0 6px 6px 0; margin-bottom: 10px; }
        .title-action-row { margin-bottom: 10px; }
        .copy-hint { font-size: 12.5px; font-weight: 700; color: #475569; margin-bottom: 8px; }
        .copy-secondary-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 8px 0; }
        .btn-copy-primary-large { width: 100%; padding: 16px; font-size: 15px; font-weight: 800; border: none; border-radius: 10px; cursor: pointer; background: linear-gradient(135deg, var(--primary-color), var(--primary-hover)); color: white; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 12px rgba(59,91,219,0.3); transition: 0.2s; box-sizing: border-box; }
        .btn-copy-primary-large:hover { filter: brightness(1.05); }
        .btn-copy-primary-large.copied { background: linear-gradient(135deg, var(--accent-color), var(--accent-hover)); box-shadow: 0 4px 12px rgba(13,148,136,0.3); }
        .btn-copy-secondary { padding: 11px 8px; font-size: 12.5px; font-weight: 700; border: 1.5px solid #cbd5e1; border-radius: 8px; cursor: pointer; background: white; color: #475569; display: flex; align-items: center; justify-content: center; gap: 5px; transition: 0.2s; box-sizing: border-box; width: 100%; }
        .btn-copy-secondary:hover { background: #f8fafc; }
        .btn-copy-secondary.copied { border-color: var(--accent-color); color: var(--accent-color); background: #f0fdfa; }
        .btn-refresh-inline { width: 100%; padding: 9px; font-size: 12.5px; font-weight: 700; border: 1.5px solid #cbd5e1; border-radius: 8px; cursor: pointer; background: #f8fafc; color: #475569; margin-bottom: 8px; box-sizing: border-box; transition: 0.2s; }
        .btn-refresh-inline:hover { background: #f1f5f9; }
        .btn-go-cta-large { width: 100%; padding: 16px; font-size: 15px; font-weight: 800; border: none; border-radius: 10px; cursor: pointer; background: linear-gradient(135deg, var(--accent-color), var(--accent-hover)); color: white; display: flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; box-sizing: border-box; box-shadow: 0 4px 12px rgba(13,148,136,0.3); transition: 0.2s; }
        .btn-go-cta-large:hover { filter: brightness(1.05); }
        @media (min-width: 601px) {
            .title-action-row { position: sticky; top: var(--sms-sticky-offset, 90px); z-index: 95; background: white; padding: 10px 0 12px; box-shadow: 0 6px 14px -8px rgba(0,0,0,0.15); }
        }
        .btn-copy-inline { padding: 10px 14px; font-size: 13px; font-weight: 600; border: none; border-radius: 8px; cursor: pointer; transition: 0.2s; background-color: var(--primary-color); color: white; display: inline-flex; align-items: center; justify-content: center; gap: 5px; }
        .btn-copy-inline:hover { background-color: var(--primary-hover); }
        .btn-copy-inline.copied { background-color: var(--accent-color); }
        .btn-go-epeople-title { padding: 10px 14px; font-size: 13px; font-weight: 600; border: none; border-radius: 8px; cursor: pointer; transition: 0.2s; background-color: var(--accent-color); color: white; display: inline-flex; align-items: center; justify-content: center; gap: 5px; text-decoration: none; box-sizing: border-box; }
        .btn-go-epeople-title:hover { background-color: var(--accent-hover); }

        textarea#resultBox { width: 100%; height: 420px; border: 1px solid #cbd5e1; border-radius: 8px; padding: 15px; box-sizing: border-box; font-size: 14px; resize: none; background-color: #fafafa; line-height: 1.6; color: #334155; }

        .btn-group-top { display: flex; gap: 10px; margin-top: 15px; flex-wrap: wrap; }
        button.action-btn, a.action-link-btn { flex: 1; min-width: 150px; padding: 14px; font-size: 14px; font-weight: 600; border: none; border-radius: 8px; cursor: pointer; transition: 0.2s; display: inline-flex; align-items: center; justify-content: center; gap: 6px; text-decoration: none; text-align: center; box-sizing: border-box; }
        .btn-refresh { background-color: var(--slate); color: white; }
        .btn-refresh:hover { background-color: var(--slate-hover); }
        .btn-copy { background-color: var(--primary-color); color: white; }
        .btn-copy:hover { background-color: var(--primary-hover); }
        .btn-copy.copied { background-color: var(--accent-color); }
        .btn-copy-body { background-color: #4f6fce; color: white; }
        .btn-copy-body:hover { background-color: #3b5bdb; }
        .btn-copy-body.copied { background-color: var(--accent-color); }

        .toast { position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%) translateY(20px); background: #1e293b; color: white; padding: 14px 22px; border-radius: 12px; font-size: 14px; font-weight: bold; opacity: 0; pointer-events: none; transition: opacity 0.3s, transform 0.3s; z-index: 9999; text-align: center; max-width: 320px; box-shadow: 0 8px 20px rgba(0,0,0,0.25); white-space: pre-line; }
        .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

        .top-index-tabs-wrap { position: sticky; top: 0; z-index: 100; background: white; padding: 10px 0 12px; margin: 0 -25px 18px; padding-left: 25px; padding-right: 25px; box-shadow: 0 4px 10px -4px rgba(0,0,0,0.08); }
        /* 시의원 문자 보내기 기능 임시 비활성화 — 다시 켜려면 이 규칙과 HTML의 feature-hidden 클래스를 지우면 됩니다. */
        .top-index-tabs-wrap.feature-hidden { display: none; }
        .top-index-tabs { display: grid; grid-template-columns: 1.3fr 1fr; gap: 10px; margin-bottom: 0; }
        .top-tab-btn { padding: 14px; font-size: 14.5px; font-weight: 700; border: 2px solid #e2e8f0; border-radius: 10px; background: white; cursor: pointer; color: #64748b; transition: 0.2s; }
        .top-tab-btn.active { border-color: var(--primary-color); background: var(--primary-color); color: white; box-shadow: 0 4px 12px rgba(59,91,219,0.25); }
        #topTabAction { position: relative; background: linear-gradient(135deg, #0d9488, #0f766e); color: white; border: 2px solid #0f766e; font-size: 15.5px; box-shadow: 0 4px 16px rgba(15,118,110,0.35); animation: pulseAction 2s infinite; }
        #topTabAction.active { background: linear-gradient(135deg, #0d9488, #0f766e); border-color: #0f766e; box-shadow: 0 4px 16px rgba(15,118,110,0.45); }
        @keyframes pulseAction { 0%, 100% { box-shadow: 0 4px 16px rgba(15,118,110,0.35); } 50% { box-shadow: 0 4px 22px rgba(15,118,110,0.6); } }
        .urgent-badge { position: absolute; top: -9px; right: -6px; background: #dc2626; color: white; font-size: 10px; font-weight: 800; padding: 3px 7px; border-radius: 999px; box-shadow: 0 2px 6px rgba(220,38,38,0.5); animation: badgeBlink 1.6s infinite; white-space: nowrap; }
        @keyframes badgeBlink { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.85; transform: scale(1.06); } }
        .sms-urgency-banner { background: linear-gradient(135deg, #fff1f2, #ffe4e6); border: 2px solid #fda4af; border-radius: 10px; padding: 12px 16px; margin-bottom: 16px; font-size: 13px; font-weight: 700; color: #9f1239; text-align: center; line-height: 1.6; }
        .top-panel { display: none; }
        .top-panel.active { display: block; }

        .sticky-copy-bar { display: none; }
        button, a { -webkit-tap-highlight-color: transparent; touch-action: manipulation; }

        .sms-status-box { background: #ecfeff; border: 1px solid #a5f3fc; border-radius: 10px; padding: 14px 16px; margin-bottom: 18px; position: sticky; top: var(--sms-sticky-offset, 90px); z-index: 90; box-shadow: 0 4px 10px -4px rgba(6,182,212,0.25); }
        .sms-status-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
        .sms-status-label { font-size: 13.5px; font-weight: 800; color: #0e7490; }
        .sms-status-count { font-size: 14px; font-weight: 800; color: #0e7490; }
        .sms-progress-track { background: #cffafe; border-radius: 999px; height: 10px; overflow: hidden; }
        .sms-progress-fill { background: linear-gradient(90deg, #06b6d4, #0891b2); height: 100%; border-radius: 999px; transition: width 0.3s; }
        .sms-reset-btn { margin-top: 10px; background: none; border: none; font-size: 11.5px; color: #0e7490; text-decoration: underline; cursor: pointer; padding: 0; }

        .sms-guide-sub { font-size: 12px; color: #6b21a8; margin-bottom: 12px; }
        .sms-intro-sub { padding: 0 2px; }
        .sms-guide-group-label { font-size: 12.5px; font-weight: 700; color: #6b21a8; margin-bottom: 6px; margin-top: 4px; }
        .sms-party-block { border-radius: 12px; padding: 16px 18px; margin-bottom: 16px; border: 2px solid; }
        .sms-party-block.party-ppp { background: #fef2f2; border-color: #fecaca; }
        .sms-party-block.party-dp { background: #eff6ff; border-color: #bfdbfe; }
        .sms-party-header { font-size: 15.5px; font-weight: 900; margin-bottom: 12px; }
        .sms-party-block.party-ppp .sms-party-header { color: #b91c1c; }
        .sms-party-block.party-dp .sms-party-header { color: #1d4ed8; }
        .sms-party-sub { font-size: 12px; font-weight: 700; margin: 14px 0 8px; }
        .sms-party-block.party-ppp .sms-party-sub { color: #b91c1c; }
        .sms-party-block.party-dp .sms-party-sub { color: #1d4ed8; }
        .sms-example-box { background: #fffbeb; border: 1px dashed #fcd34d; border-radius: 10px; padding: 12px 14px; margin-bottom: 14px; }
        .sms-example-label { font-size: 12px; font-weight: 800; color: #92400e; margin-bottom: 6px; }
        .sms-example-text { font-size: 13px; color: #78350f; line-height: 1.6; user-select: none; -webkit-user-select: none; -moz-user-select: none; -ms-user-select: none; cursor: default; }
        .freeform-label-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 6px; }
        .freeform-label-row .freeform-label { margin-bottom: 0; }
        .sms-clear-btn { background: none; border: none; font-size: 11.5px; color: #9333ea; text-decoration: underline; cursor: pointer; padding: 0; white-space: nowrap; }
        .sms-compose-box { height: 100px; margin-top: 4px; }
        .sms-paste-notice { font-size: 11px; color: #9333ea; margin-top: 5px; }
        .sms-char-info { font-size: 11.5px; color: #64748b; margin-top: 6px; min-height: 14px; }

        .sms-member-list { display: flex; flex-direction: column; gap: 8px; }
        .sms-member-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 10px 12px; transition: opacity 0.5s ease, filter 0.5s ease; }
        .sms-member-row.sent { opacity: 0.35; filter: grayscale(80%); pointer-events: none; }
        .sms-member-info { display: flex; flex-direction: column; gap: 2px; min-width: 90px; }
        .sms-member-name { font-size: 13.5px; font-weight: 800; color: #1e293b; }
        .sms-member-phone { font-size: 11.5px; color: #64748b; }
        .sms-member-actions { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
        .sms-send-btn { background: #0d9488; color: white; font-size: 12.5px; font-weight: 700; padding: 9px 12px; border-radius: 8px; text-decoration: none; white-space: nowrap; }
        .sms-send-btn:active { background: #0f766e; }
        .sms-copy-btn { background: white; border: 1px solid #cbd5e1; color: #475569; font-size: 12px; font-weight: 600; padding: 9px 10px; border-radius: 8px; cursor: pointer; }
        .sms-sent-badge { font-size: 11.5px; font-weight: 800; color: #16a34a; min-width: 70px; text-align: right; }
        .sms-need-text-hint { font-size: 11.5px; color: #94a3b8; }

        @media (max-width: 600px) {
            body { padding: 0; background: white; }
            .container { margin: 0; padding: 16px; border-radius: 0; box-shadow: none; }
            .top-index-tabs-wrap { margin: 0 -16px 18px; padding-left: 16px; padding-right: 16px; top: 0; }
            h2 { font-size: 16.5px; line-height: 1.4; }
            p.desc { font-size: 13px; margin-bottom: 18px; }
            .dong-input-box { gap: 6px; padding: 10px; }
            .dong-input-box select { font-size: 12px; max-width: 100%; flex: 1 1 100%; }
            .dong-input-box input { font-size: 12px; width: 50px; }
            .title-action-row { display: none !important; }
            .title-box { font-size: 13px; padding: 10px 12px; }
            .usage-guide-swipe-handle { display: block; width: 38px; height: 4px; border-radius: 999px; background: #fdba74; margin: 8px auto -2px; }
            .usage-guide-box { touch-action: pan-y; }
            .usage-guide-toggle { padding: 11px 14px 13px; }
            .usage-guide-toggle-left { font-size: 13.5px; }
            .usage-guide-content { padding: 0 14px 14px; touch-action: pan-y; }
            .usage-guide-box.collapsed .usage-guide-content { padding: 0 14px; }
            .usage-guide-steps { font-size: 13px; padding-left: 18px; }
            .usage-guide-note { font-size: 11.5px; }
            textarea#resultBox { height: 280px; font-size: 13px; padding: 12px; }
            .btn-group-top { margin-top: 10px; }
            .toast { bottom: calc(env(safe-area-inset-bottom, 0px) + 80px); max-width: 88vw; font-size: 13px; padding: 13px 18px; }

            .sticky-copy-bar {
                display: flex; position: fixed; bottom: 0; left: 0; right: 0; background: #f8fafc;
                border-top: 4px solid transparent; border-image: linear-gradient(90deg, var(--primary-color), var(--accent-color)) 1;
                padding: 11px 12px; padding-bottom: calc(11px + env(safe-area-inset-bottom, 0px));
                gap: 6px; z-index: 100; box-shadow: 0 -10px 26px rgba(15,23,42,0.22);
            }
            .sticky-copy-bar button, .sticky-copy-bar a {
                flex: 1; padding: 12px 2px; font-size: 10.5px; font-weight: 800; border-radius: 10px;
                cursor: pointer; text-align: center; text-decoration: none; display: flex; align-items: center;
                justify-content: center; flex-direction: column; gap: 2px; line-height: 1.3; white-space: nowrap;
            }
            .sticky-bar-title { background: #e0e7ff; color: #3730a3; border: 1.5px solid #a5b4fc !important; }
            .sticky-bar-body { background: #e0e7ff; color: #3730a3; border: 1.5px solid #a5b4fc !important; }
            .sticky-bar-all { background: linear-gradient(135deg, var(--primary-color), var(--primary-hover)); color: white; box-shadow: 0 3px 10px rgba(59,91,219,0.4); border: none; }
            .sticky-bar-epeople { background: linear-gradient(135deg, var(--accent-color), var(--accent-hover)); color: white; box-shadow: 0 3px 10px rgba(13,148,136,0.4); border: none; }
            .sticky-bar-refresh { background: #fff7ed; color: #c2410c; border: 1.5px solid #fdba74 !important; }
            /* 잠긴(개인화 전) 상태에서는 색을 흐릿하게 필터링하는 대신 또렷한 회색 "비활성" 스타일로 표시해 흐려 보이지 않게 합니다. */
            .sticky-copy-bar .gate-locked {
                opacity: 1 !important; filter: none !important;
                background: #e2e8f0 !important; color: #94a3b8 !important;
                border: 1.5px solid #cbd5e1 !important; box-shadow: none !important;
            }
            #panelAction { padding-bottom: 85px; }
        }
    </style>
</head>
<body>

<div class="container">
    <h2>🚀 과천 주암 데이터센터 대응 민원·의견서 도우미</h2>
    <p class="desc">LH·국토교통부·과천시·한국전력·과천소방서·한국부동산원 민원(국민신문고)을 이 페이지 하나로 준비할 수 있습니다. 나만의 사연을 반드시 넣어야 매번 다른 문장으로 생성됩니다.</p>

    <!-- 시의원 문자 보내기 기능 임시 비활성화: feature-hidden 클래스만 지우면 다시 노출됩니다 -->
    <div class="top-index-tabs-wrap feature-hidden">
        <div class="top-index-tabs">
            <button id="topTabWrite" class="top-tab-btn active" onclick="switchTopTab('write')">📝 민원·의견서 작성</button>
            <button id="topTabAction" class="top-tab-btn" onclick="switchTopTab('sms')">📱 시의원 문자 보내기<span class="urgent-badge">이번주 필수!</span></button>
        </div>
    </div>

    <div id="panelWrite" class="top-panel active">

    <!-- ===================== 작성 패널 ===================== -->
    <div id="panelAction">

    <div class="usage-guide-box" id="usageGuideBox">
        <div class="usage-guide-swipe-handle" aria-hidden="true"></div>
        <button type="button" class="usage-guide-toggle" id="usageGuideToggle" onclick="toggleUsageGuide()">
            <span class="usage-guide-toggle-left">📌 처음이신가요? 이렇게 사용하세요</span>
            <span class="usage-guide-arrow" id="usageGuideArrow">▲</span>
        </button>
        <div class="usage-guide-content" id="usageGuideContent">
        <ol class="usage-guide-steps">
            <li><strong>①</strong> 먼저 <strong>"국민신문고 바로가기"</strong> 버튼으로 이동해 <strong>본인 계정으로 로그인</strong>하세요</li>
            <li><strong>②</strong> 로그인 후 상단 <strong>"민원" → "일반민원"</strong> 메뉴에서 아래 화면처럼 <span class="highlight-mark">"민원신청"</span>을 클릭하세요</li>
        </ol>
        <div class="usage-guide-screenshot-wrap"><img src="data:image/png;base64," alt="국민신문고 민원신청 클릭 위치 안내" class="usage-guide-screenshot"></div>
        <ol class="usage-guide-steps" start="3">
            <li><strong>③</strong> 이 페이지로 돌아와 민원 넣을 <strong>기관을 선택</strong>하고, 보라색 상자에서 <strong>나만의 사연</strong>을 선택·입력하세요 (필수)</li>
            <li><strong>④</strong> 생성된 <strong>제목·본문 내용을 한 번씩 꼭 읽어보고</strong> 내가 제출하는 내용이 무엇인지 이해한 뒤 진행하세요</li>
            <li><strong>⑤</strong> <strong>"제목만 복사"</strong>를 눌러 국민신문고 <strong>제목란</strong>에, <strong>"본문만 복사"</strong>를 눌러 <strong>본문란</strong>에 각각 붙여넣고 제출하세요</li>
            <li><strong>⑥</strong> 위쪽 <strong>6개 기관 탭(LH·국토교통부·과천시·한국전력·과천소방서·부동산원)을 하나씩 눌러가며 ①~⑤ 과정을 반복</strong>해 <strong>6곳 모두 제출</strong>해주세요</li>
        </ol>
        <div class="usage-guide-note">⚠️ 이 페이지는 민원을 대신 접수하지 않습니다. 제목과 본문은 <strong>각각 따로 복사</strong>해서 해당 칸에 붙여넣어야 하며, 국민신문고에 <strong>본인이 로그인하여 직접</strong> 제출해야 최종 접수됩니다. <strong>6개 기관 민원을 모두 제출</strong>해야 효과가 커집니다 — 하나도 빠짐없이 부탁드려요!</div>
        </div>
    </div>

    <div class="mode-tabs">
        <button id="btnModeLh" class="mode-btn active mode-lh" onclick="switchMode('lh')"><span class="mode-complete-check" id="agencyCheck_lh" onclick="event.stopPropagation(); toggleAgencyDone('lh');" role="checkbox" aria-checked="false" aria-label="LH 민원 제출 완료 표시">☐</span>🏗️ LH 민원<br><span style="font-weight:400; font-size:11.5px;">(국민신문고)</span></button>
        <button id="btnModeMoland" class="mode-btn mode-moland" onclick="switchMode('moland')"><span class="mode-complete-check" id="agencyCheck_moland" onclick="event.stopPropagation(); toggleAgencyDone('moland');" role="checkbox" aria-checked="false" aria-label="국토교통부 민원 제출 완료 표시">☐</span>🏢 국토교통부 민원<br><span style="font-weight:400; font-size:11.5px;">(국민신문고)</span></button>
        <button id="btnModeGwacheon" class="mode-btn mode-gwacheon" onclick="switchMode('gwacheon')"><span class="mode-complete-check" id="agencyCheck_gwacheon" onclick="event.stopPropagation(); toggleAgencyDone('gwacheon');" role="checkbox" aria-checked="false" aria-label="과천시 민원 제출 완료 표시">☐</span>🏙️ 과천시 민원<br><span style="font-weight:400; font-size:11.5px;">(국민신문고)</span></button>
        <button id="btnModeKepco" class="mode-btn mode-kepco" onclick="switchMode('kepco')"><span class="mode-complete-check" id="agencyCheck_kepco" onclick="event.stopPropagation(); toggleAgencyDone('kepco');" role="checkbox" aria-checked="false" aria-label="한국전력 민원 제출 완료 표시">☐</span>⚡ 한국전력 민원<br><span style="font-weight:400; font-size:11.5px;">(국민신문고)</span></button>
        <button id="btnModeFire" class="mode-btn mode-fire" onclick="switchMode('fire')"><span class="mode-complete-check" id="agencyCheck_fire" onclick="event.stopPropagation(); toggleAgencyDone('fire');" role="checkbox" aria-checked="false" aria-label="과천소방서 민원 제출 완료 표시">☐</span>🚒 과천소방서 민원<br><span style="font-weight:400; font-size:11.5px;">(국민신문고)</span></button>
        <button id="btnModeBudongsan" class="mode-btn mode-budongsan" onclick="switchMode('budongsan')"><span class="mode-complete-check" id="agencyCheck_budongsan" onclick="event.stopPropagation(); toggleAgencyDone('budongsan');" role="checkbox" aria-checked="false" aria-label="부동산원 민원 제출 완료 표시">☐</span>🏛️ 부동산원 민원<br><span style="font-weight:400; font-size:11.5px;">(국민신문고)</span></button>
    </div>

    <div class="agency-progress-box" id="agencyProgressBox">
        <div class="agency-progress-row">
            <span class="agency-progress-label">📮 기관별 제출 현황</span>
            <span class="agency-progress-count" id="agencyProgressText">0 / 6개 기관 제출 완료</span>
        </div>
        <div class="agency-progress-track"><div class="agency-progress-fill" id="agencyProgressFill" style="width:0%"></div></div>
        <div class="agency-progress-hint">위 탭의 동그라미를 눌러 제출을 마친 기관을 체크해두세요. 새로고침해도 이 브라우저에 기억돼요.</div>
    </div>

    <div class="personalize-box">
        <div class="personalize-title">✍️ 나만의 이유로 개인화하기 <span style="color:#dc2626;">(필수)</span></div>
        <div class="personalize-sub">해당하는 항목을 눌러 선택하세요 (복수 선택 가능). 선택한 문장이 본문에 자동으로 들어갑니다.</div>
        <div class="personalize-required-note" id="personalizeRequiredNote">⚠️ 최소 1개 이상 선택하거나 직접 사연을 적어야 복사·제출이 가능해요.</div>
        <div class="keyword-grid" id="keywordGrid"></div>
        <label class="freeform-label" for="freeformInput">📝 직접 사연을 적어주세요</label>
        <textarea id="freeformInput" class="freeform-input" placeholder="예: 곧 태어날 아이와 함께 이 동네에 오래 살고 싶어서 걱정이 큽니다." oninput="onInputsChanged()"></textarea>
    </div>

    <div class="title-action-row">
        <div class="copy-hint">👇 제목·본문을 각각 따로 복사해서 국민신문고 해당 칸에 붙여넣으세요</div>
        <button class="btn-refresh-inline" onclick="generate(true)">🔄 문장 다시 섞기</button>
        <button id="btnCopyAll" class="btn-copy-primary-large" onclick="if(checkPersonalized()) copyAll();">📋 제목+본문 한번에 복사</button>
        <div class="copy-secondary-row">
            <button id="btnCopyTitle" class="btn-copy-secondary" onclick="if(checkPersonalized()) copyTitle();">📋 제목만 복사</button>
            <button id="btnCopyBody" class="btn-copy-secondary" onclick="if(checkPersonalized()) copyBody();">📄 본문만 복사</button>
        </div>
        <a id="btnGoTarget" href="https://www.epeople.go.kr/index.paid" target="_blank" class="btn-go-cta-large" onclick="return checkPersonalized();">🏛️ 국민신문고 바로가기 →</a>
    </div>

    <div class="meta-info" id="metaInfoLine">📍 접수 기관: 한국토지주택공사(LH) 공공택지사업처·의왕과천사업본부</div>

    <div class="title-row">
        <div id="titleDisplay" class="title-box">민원 제목: 로딩 중...</div>
    </div>

    <textarea id="resultBox" readonly></textarea>

    </div>
    <!-- ===================== /작성 패널 ===================== -->

    <!-- 모바일 하단 고정 복사 바 -->
    <div class="sticky-copy-bar" id="stickyCopyBar">
        <button class="sticky-bar-refresh" onclick="generate(true)">🔄<br>내용섞기</button>
        <button id="stickyBtnAll" class="sticky-bar-all" onclick="if(checkPersonalized()) copyAll();">📋<br>전체복사</button>
        <a id="stickyBtnTarget" href="https://www.epeople.go.kr/index.paid" target="_blank" class="sticky-bar-epeople" onclick="return checkPersonalized();">🏛️<br>신문고이동</a>
        <button id="stickyBtnTitle" class="sticky-bar-title" onclick="if(checkPersonalized()) copyTitle();">📋<br>제목복사</button>
        <button id="stickyBtnBody" class="sticky-bar-body" onclick="if(checkPersonalized()) copyBody();">📄<br>본문복사</button>
    </div>

    <div style="margin-top:24px; padding-top:16px; border-top:1px solid #e2e8f0; font-size:11.5px; color:#94a3b8; line-height:1.8; text-align:center;">
        본 페이지는 주민 개인이 비영리·공익 목적으로 제작한 참고용 도구입니다. <strong>민원·의견서를 자동으로 발송하거나 대리 제출하지 않습니다.</strong><br>
        여기서 생성되는 글은 작성을 돕기 위한 참고용 예시 문구일 뿐입니다. <strong>모든 민원·의견서는 이용자 본인이 자신의 이름과 책임으로</strong> 국민신문고 로그인을 통해 직접 제출해야 합니다.<br>
        제공되는 문구에 포함된 사실관계 주장은 언론보도·공개 법령/판례·공고문 등 공개 자료에 근거한 주민 개인의 우려와 의견 표명입니다. 특정 단체·기업·개인을 비방하거나 영업활동을 방해할 의도가 없습니다.<br>
        이 사이트 및 제작자는 이용자가 작성·제출한 내용이나 그로 인해 발생하는 결과에 대해 <strong>어떠한 법적 책임도 지지 않습니다.</strong> 사실관계는 관계 기관의 공식 확인을 통해 판단하시고 제출 전 내용을 직접 확인·수정하시기 바랍니다.
    </div>

    </div>
    <!-- ===================== /작성 패널(top) ===================== -->

    <!-- ===================== 문자 발송 패널 ===================== -->
    <div id="panelSms" class="top-panel">

        <div class="sms-urgency-banner">🔥 이번주가 고비입니다! 8월 20일(목) 임시회 전에 최대한 많은 분이 문자를 보내주셔야 힘이 됩니다.</div>

        <div class="sms-status-box">
            <div class="sms-status-row">
                <span class="sms-status-label">📊 발송 현황</span>
                <span class="sms-status-count" id="smsStatusCount">0 / 7명 발송완료</span>
            </div>
            <div class="sms-progress-track"><div class="sms-progress-fill" id="smsProgressFill" style="width:0%"></div></div>
            <button type="button" class="sms-reset-btn" id="smsResetBtn" onclick="resetSmsProgress()">↺ 발송 기록 초기화</button>
        </div>

        <div class="sms-guide-sub sms-intro-sub">두 정당은 어조가 달라서 문자 내용을 따로 준비하도록 나눴어요. 완성된 문구를 그대로 복사해서 붙여넣는 것은 막아두었습니다 — 지금은 정성이 담긴 직접 쓴 문자가 더 큰 힘이 되는 때라고 생각합니다.</div>

        <div class="sms-party-block party-ppp">
            <div class="sms-party-header">🔴 국민의힘 의원께</div>

            <div class="sms-example-box">
                <div class="sms-example-label">💡 예시 문자 (참고용 — 그대로 복사할 수 없어요)</div>
                <div class="sms-example-text" oncontextmenu="return false;" onselectstart="return false;" oncopy="return false;">의원님, 조례 개정에 힘써주셔서 정말 감사합니다. 지금 주민들이 느끼는 불안과 우려는 한계에 다다랐습니다. 일초가 다급한 사안인 만큼, 하루빨리 개정이 완료되어 실질적인 보호 조치가 이뤄질 수 있도록 신속하게 처리해 주시길 간곡히 부탁드립니다!</div>
            </div>

            <div class="sms-guide-group-label">👇 눌러서 조합해보세요</div>
            <div class="keyword-grid" id="smsGuidePpp"></div>

            <div class="freeform-label-row">
                <label class="freeform-label" for="smsComposeBox_ppp">✏️ 국민의힘 의원께 보낼 문자 (직접 작성)</label>
                <button type="button" class="sms-clear-btn" onclick="clearSmsCompose('ppp')">✕ 지우고 다시 쓰기</button>
            </div>
            <textarea id="smsComposeBox_ppp" class="freeform-input sms-compose-box" placeholder="위 표현을 눌러 조합해보거나, 처음부터 직접 문자 내용을 작성해 주세요. (붙여넣기는 되지 않아요)" oninput="onSmsComposeChanged('ppp')" onpaste="return false;" ondrop="return false;" ondragover="return false;"></textarea>
            <div class="sms-paste-notice">🚫 붙여넣기 방지 — 진심을 담아 직접 적어주시면 더 큰 힘이 됩니다.</div>
            <div class="sms-char-info" id="smsCharInfo_ppp"></div>

            <div class="sms-party-sub">✅ 문구를 쓰면 아래 국민의힘 의원 5명께 바로 이어서 보낼 수 있어요.</div>
            <div class="sms-member-list" id="smsListPpp"></div>
        </div>

        <div class="sms-party-block party-dp">
            <div class="sms-party-header">🔵 더불어민주당 의원께</div>

            <div class="sms-example-box">
                <div class="sms-example-label">💡 예시 문자 (참고용 — 그대로 복사할 수 없어요)</div>
                <div class="sms-example-text" oncontextmenu="return false;" onselectstart="return false;" oncopy="return false;">의원님, 지금 과천 주민의 안전이 심각한 위기에 직면해 있습니다. 주민의 안전을 지키는 일에는 어떠한 이견도 있을 수 없다고 생각합니다. 더 지체할 시간이 없습니다. 부디 모든 뜻을 하나로 모아 하루속히 조례 개정에 앞장서 주시길 부탁드립니다.</div>
            </div>

            <div class="sms-guide-group-label">👇 눌러서 조합해보세요</div>
            <div class="keyword-grid" id="smsGuideDp"></div>

            <div class="freeform-label-row">
                <label class="freeform-label" for="smsComposeBox_dp">✏️ 더불어민주당 의원께 보낼 문자 (직접 작성)</label>
                <button type="button" class="sms-clear-btn" onclick="clearSmsCompose('dp')">✕ 지우고 다시 쓰기</button>
            </div>
            <textarea id="smsComposeBox_dp" class="freeform-input sms-compose-box" placeholder="위 표현을 눌러 조합해보거나, 처음부터 직접 문자 내용을 작성해 주세요. (붙여넣기는 되지 않아요)" oninput="onSmsComposeChanged('dp')" onpaste="return false;" ondrop="return false;" ondragover="return false;"></textarea>
            <div class="sms-paste-notice">🚫 붙여넣기 방지 — 진심을 담아 직접 적어주시면 더 큰 힘이 됩니다.</div>
            <div class="sms-char-info" id="smsCharInfo_dp"></div>

            <div class="sms-party-sub">✅ 문구를 쓰면 아래 더불어민주당 의원 2명께 바로 이어서 보낼 수 있어요.</div>
            <div class="sms-member-list" id="smsListDp"></div>
        </div>

        <div style="margin-top:24px; padding-top:16px; border-top:1px solid #e2e8f0; font-size:11.5px; color:#94a3b8; line-height:1.8; text-align:center;">
            문자 보내기 버튼을 누르면 <strong>이용자 본인의 휴대폰 문자(SMS) 앱</strong>이 열립니다. 실제 발송은 본인이 앱에서 직접 눌러야 완료됩니다. 이 사이트는 문자를 대신 발송하거나 자동으로 전송하지 않습니다. 발송 현황은 <strong>이용자의 브라우저에만 저장</strong>되고 서버로 전송·수집되지 않습니다. 문자 발송 시 통신사 요금이 부과될 수 있습니다.
        </div>

    </div>
    <!-- ===================== /문자 발송 패널 ===================== -->
</div>

<div class="toast" id="toastMsg"></div>

<script>
    /* ===================== 공통: 개인화 키워드 (두 모드 공용) ===================== */
    const KEYWORDS = [
        { id: "kid", label: "🧒 어린 자녀가 있어요", sentence: "본인의 가정에는 어린 자녀가 있어 전자파·소음 등 데이터센터로 인한 환경 변화에 특히 민감할 수밖에 없는 상황입니다." },
        { id: "baby", label: "🤰 임신 중이거나 영유아가 있어요", sentence: "출산을 앞두고 있거나 영유아를 양육하고 있어 주거지 인근 대규모 전력시설 건립에 대한 우려가 더욱 큽니다." },
        { id: "elder", label: "🧓 노약자·환자와 함께 살아요", sentence: "고령이거나 건강이 취약한 가족과 함께 거주하고 있어 소음과 전자파 등 환경 변화에 더욱 민감하게 영향을 받을 수 있습니다." },
        { id: "school", label: "🏫 통학·통근길이 겹쳐요", sentence: "인근 어린이집·학교 통학 동선 및 일상 생활권과 사업 부지가 겹쳐 있어 안전에 대한 우려가 큽니다." },
        { id: "prior", label: "📨 이미 다른 기관에도 의견을 냈어요", sentence: "이미 관계기관에 동일한 사안으로 민원·의견을 제출한 바 있습니다. 이번에도 동일한 우려가 반드시 반영되기를 바랍니다." }
    ];

    const selectedKeywords = new Set();
    let currentMode = 'lh';

    function getRandomIndex(max) { return Math.floor(Math.random() * max); }

    function getPersonalParagraph() {
        const kwSentences = KEYWORDS.filter(k => selectedKeywords.has(k.id)).map(k => k.sentence);
        const freeform = document.getElementById('freeformInput').value.trim();
        if (!kwSentences.length && !freeform) return "";
        let p = kwSentences.join(" ");
        if (freeform) p += (kwSentences.length ? " " : "") + freeform;
        return "\n\n" + p;
    }

    function buildKeywordGrid() {
        const grid = document.getElementById('keywordGrid');
        grid.innerHTML = '';
        KEYWORDS.forEach(k => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'keyword-chip';
            btn.innerText = k.label;
            btn.onclick = () => {
                if (selectedKeywords.has(k.id)) { selectedKeywords.delete(k.id); btn.classList.remove('active'); }
                else { selectedKeywords.add(k.id); btn.classList.add('active'); }
                generate(false);
            };
            grid.appendChild(btn);
        });
    }

    /* ===================== 모드 ① 한국부동산원 민원 ===================== */
    const budongsanTitleVariants = [
        "과천주암지구 데이터센터 리츠 영업·변경인가 보류 및 전력 편법분할·공익성 심사에 대한 구체적 답변 촉구",
        "한국부동산원 리츠 사업계획 심사 관련 편법 전력쪼개기 검증 및 주거지 근접 공익성 재검토 요청",
        "과천주암지구 리츠 영업인가·변경인가 신중 처리 및 구체적 심사 답변 재요청",
        "한국부동산원 리츠심사팀 앞 - 전력계통영향평가 회피 의혹 및 공익성 침해 우려 답변 촉구"
    ];

    const budongsanOpenings = [
        "귀 기관의 공정하고 투명한 심사 업무 수행에 감사드립니다. 아래와 같이 민원을 제출합니다.",
        "국민의 재산권 및 주거 안전을 위해 힘쓰시는 귀 기관의 책임 있는 심사를 신뢰하며 민원을 올립니다.",
        "과천주암지구 인근 주민 및 입주예정자로서 리츠 사업계획 심사의 공정성을 촉구하고자 민원을 제출합니다.",
        "귀 기관의 민원 처리 노고에 감사드립니다. 아래 사항에 대한 신중한 검토를 요청드립니다."
    ];

    const budongsanIntroVariants = [
        "본 민원인은 경기도 과천시 주암지구에 인접한 공동주택 단지의 입주예정자입니다. 기존에 「부동산투자회사법」상 리츠 사업계획 심사와 관련하여 전력계통영향평가 의무 이행 여부 및 공익성 재검토를 요청하는 민원을 제출한 바 있습니다.",
        "본 민원인은 과천주암지구 인근에 거주 예정인 주민입니다. 이전에도 리츠 사업계획의 전력계통영향평가 이행 여부와 공익성에 관한 민원을 제출하였으나 보다 구체적인 답변을 다시 한번 요청드리고자 합니다.",
        "본 민원인은 과천주암지구와 인접한 곳에 거주할 예정인 입주예정자입니다. 리츠 사업계획 심사와 관련하여 이미 한 차례 민원을 접수한 바 있으나 아래 사항에 대한 명확한 답변을 다시 촉구드립니다."
    ];

    const budongsanStaticNotice = "현재 해당 사업의 자산관리회사(코람코자산신탁, 마스턴자산운용)는 귀 기관에 영업인가 및 변경인가를 신청해 놓은 것으로 파악하고 있습니다. 이에 민원인은 아래 사항에 대한 구체적이고 실질적인 답변 없이 영업인가·변경인가가 처리되지 않도록 신중한 심사를 재차 요청드립니다.";

    const budongsanReq1Variants = [
        "[요청 1] 편법 전력 쪼개기 여부에 대한 구체적 검증\n\n주암지구 내 데이터센터 사업이 1-1·2블록, 1-9블록 등 복수 블록·복수 법인 명의로 나뉘어 있는바, 이것이 실질적으로 동일 사업임에도 계약전력을 각각 10메가와트 미만으로 분할 신고하여 「분산에너지 활성화 특별법」상 전력계통영향평가 의무를 회피하려는 것은 아닌지 구체적으로 검증해 주시기 바랍니다. \"법령에 따라 검토 중\" 등 원론적 답변이 아니라 각 블록·사업자별 계약전력 신청 현황과 합산 판단 근거를 구체적으로 밝혀 주시기 바랍니다.",
        "[요청 1] 계약전력 편법 분할(쪼개기) 여부 재확인 요청\n\n복수의 블록과 복수의 법인 명의로 진행되는 이 사업이 사실상 하나의 사업으로서 계약전력을 합산해야 함에도 각각 10메가와트 미만으로 나누어 신고함으로써 전력계통영향평가를 회피하려는 정황은 없는지 다시 한번 면밀히 확인해 주시기 바랍니다. 원론적인 답변이 아닌 실제 신청 현황과 판단 근거에 대한 구체적인 회신을 부탁드립니다."
    ];

    const budongsanReq2Variants = [
        "[요청 2] 주거지 밀착 입지에 따른 공익성 심사 반영 여부\n\n가장 인접한 사업부지가 주거지 경계로부터 약 30미터에 불과하고 인근 반경 내 어린이집 약 32개소, 학교 5개교가 밀집해 있는 점을 사업계획 심사에 구체적으로 반영하였는지 확인해 주시기 바랍니다. 이 역시 원론적 답변이 아니라 심사 과정에서 주민 건강·안전에 대한 영향을 어떤 기준과 절차로 검토하였는지 구체적으로 밝혀 주시기 바랍니다.",
        "[요청 2] 주민 건강·안전을 고려한 공익성 재검토 요청\n\n사업 부지가 주거지와 불과 30여 미터 거리에 있고 인근에 어린이집과 학교가 다수 밀집해 있는 만큼 이러한 입지 특성이 사업계획의 타당성·적정성 심사에 충분히 반영되었는지 다시 한번 검토해 주시기 바랍니다. 어떤 기준과 절차로 주민 건강·안전에 대한 영향을 평가하였는지 구체적으로 답변해 주시기 바랍니다."
    ];

    const budongsanReq3Variants = [
        "[요청 3] 영업인가·변경인가 심사의 신중한 처리 요청\n\n위 두 사항(전력계통영향평가 의무 이행 여부, 공익성 침해 우려)에 대한 검토가 명확히 완결되기 전까지 영업인가·변경인가가 성급히 처리되지 않도록 신중을 기해 주시기 바라며 현재 심사 진행 상황(처리 일정 등)을 민원인에게 안내해 주시기 바랍니다.",
        "[요청 3] 인가 절차의 신중한 진행 촉구\n\n위 사항들에 대한 명확한 확인과 검토 없이 영업인가·변경인가가 서둘러 처리되는 일이 없도록 각별히 유의해 주시기 바라며 향후 심사 일정 및 처리 절차를 안내해 주시기 바랍니다."
    ];

    const budongsanClosings = [
        "민원인은 특정 기업의 적법한 사업활동을 부당하게 방해하고자 하는 것이 아니며 다만 대규모 전력수요시설이 주거지 및 보육·교육시설과 매우 근접하여 계획되고 있는 상황에서 관계 법령상 의무가 빠짐없이 이행되었는지, 리츠 사업계획의 공익성이 충분히 검토되었는지를 감독기관으로서 명확히 확인해 주실 것을 요청드립니다. 원론적 답변이 아닌 구체적이고 실질적인 회신을 부탁드립니다.\n\n감사합니다.",
        "본 민원은 특정 사업자를 비방하거나 그 영업을 방해하려는 목적이 아니라 법과 절차에 따른 공정한 심사를 요청드리는 것입니다. 주민들의 건강과 안전이 걸린 문제인 만큼 형식적인 답변이 아닌 구체적이고 실효성 있는 검토와 회신을 부탁드립니다.\n\n감사합니다.",
        "민원인은 적법한 절차를 존중하며 다만 심사 과정에서 위 사항들이 누락 없이 충실히 검토되기를 바랄 뿐입니다. 원론적인 답변이 아닌 구체적인 근거와 절차에 기반한 회신을 간곡히 요청드립니다.\n\n감사합니다."
    ];

    let stateB = {};
    function rerollBudongsan() {
        stateB = {
            titleIdx: getRandomIndex(budongsanTitleVariants.length),
            openIdx: getRandomIndex(budongsanOpenings.length),
            introIdx: getRandomIndex(budongsanIntroVariants.length),
            req1Idx: getRandomIndex(budongsanReq1Variants.length),
            req2Idx: getRandomIndex(budongsanReq2Variants.length),
            req3Idx: getRandomIndex(budongsanReq3Variants.length),
            closeIdx: getRandomIndex(budongsanClosings.length)
        };
    }

    function buildBudongsan() {
        const intro = budongsanIntroVariants[stateB.introIdx];
        const body = budongsanOpenings[stateB.openIdx] + "\n\n" + intro + " " + budongsanStaticNotice + getPersonalParagraph()
            + "\n\n" + budongsanReq1Variants[stateB.req1Idx]
            + "\n\n" + budongsanReq2Variants[stateB.req2Idx]
            + "\n\n" + budongsanReq3Variants[stateB.req3Idx]
            + "\n\n" + budongsanClosings[stateB.closeIdx];
        return { title: budongsanTitleVariants[stateB.titleIdx], body };
    }

    /* ===================== 공통: 강경 대응 사유 뱅크 (LH·국토부·과천시·한전 공용) ===================== */
    const REASON_BANK = [
        { title: "수도권 집중 완화 국정과제 위배", text: "정부는 국토 균형발전과 수도권 인구·기능 분산을 핵심 국정과제로 추진하고 있습니다. 대규모 전력을 소비하는 첨단 인프라 시설을 수도권 한복판에 신축하는 것은 이러한 국정 기조에 정면으로 배치되는 것으로 보입니다." },
        { title: "RE100·에너지 전환 정책 역행", text: "글로벌 기업들은 RE100 달성을 위해 신재생에너지 사용을 사실상 필수 요건으로 요구하고 있습니다. 신재생에너지 공급이 구조적으로 제한적인 수도권에 대규모 데이터센터를 신축하는 것은 정부의 탄소중립 목표 및 에너지 전환 정책과 역행하는 방향이라고 판단됩니다." },
        { title: "수도권 전력계통 과부하 우려", text: "수도권 전력망은 이미 한계에 가까운 상황입니다. 단일 시설로 수십 메가와트 이상을 지속 소비하는 데이터센터가 들어설 경우 지역 전력계통의 안정성과 수급에 상당한 부담을 줄 것으로 우려됩니다. 「분산에너지 활성화 특별법」 및 「전기사업법」에서도 전력 계통에 과도한 부담을 주는 대용량 시설에 대해서는 신중한 접근이 필요하다고 규정하고 있는 것으로 알고 있습니다." },
        { title: "주거 밀집지역 인접에 따른 주민안전 위협", text: "데이터센터 예정 부지는 인근 주거지 및 양재천 수변공원 등 주민 생활권과 불과 수십 미터 거리에 위치해 있습니다. 24시간 가동되는 냉각설비의 소음·진동, 송전선로에 따른 전자파, 비상발전기 배출가스 등은 주민 건강과 일상생활에 실질적인 영향을 줄 수 있어 우려가 큽니다." },
        { title: "공공택지 취지에 맞지 않는 특혜성 개발 우려", text: "공공주택지구 부지는 본래 공공적 목적을 위해 조성된 것입니다. 이 부지에 대규모 민간 데이터센터 개발이 허용될 경우 공공사업의 취지와 맞지 않는 특혜성 개발로 비칠 소지가 있다고 생각합니다. 신재생에너지 자원과 부지가 확보된 지방에 데이터센터를 구축해도 서비스 제공에는 지장이 없다는 점에서 더욱 그렇습니다." },
        { title: "수도권 데이터센터 난립의 악선례", text: "주거 쾌적성이 최우선되어야 할 공공주택지구 내 데이터센터 신축을 허용할 경우 수도권 전역의 주택지구·준주거지역에 유사 시설이 확산되는 나쁜 선례가 될 수 있습니다. 이는 향후 되돌리기 어려운 결과를 낳을 수 있어 신중한 판단이 필요합니다." }
    ];

    function pickReasonIndices(n) {
        const idxs = [...Array(REASON_BANK.length).keys()];
        for (let i = idxs.length - 1; i > 0; i--) {
            const j = getRandomIndex(i + 1);
            [idxs[i], idxs[j]] = [idxs[j], idxs[i]];
        }
        return idxs.slice(0, n);
    }

    function buildReasonsBlock(idxArr) {
        return idxArr.map((idx, i) => {
            const r = REASON_BANK[idx];
            return `[문제 제기 ${i + 1}] ${r.title}\n\n${r.text}`;
        }).join('\n\n');
    }

    const WARNING_VARIANTS = [
        "만약 이러한 정당한 요구가 받아들여지지 않고 주민의 주거환경과 안전을 도외시한 채 관련 절차가 그대로 강행될 경우 주민들은 행정처분의 효력정지 및 취소를 구하는 법적 절차를 포함하여 가능한 모든 정당한 수단을 검토하지 않을 수 없다는 점을 말씀드립니다.",
        "주민들의 정당한 우려에도 불구하고 관련 절차가 일방적으로 강행될 경우 부득이하게 법적 대응을 포함한 모든 수단을 검토할 수밖에 없다는 점을 미리 말씀드립니다."
    ];

    /* ===================== 모드 ② LH(한국토지주택공사) 민원 ===================== */
    const lhTitleVariants = [
        "장군마을 민관협의체 요청사항(데이터센터 삭제) 중간검토 결과 공유 및 신속 처리 촉구",
        "미매각 업무시설용지 데이터센터 허용용도 삭제 요청 건 - 중간검토 진행상황 확인 및 조속 처리 요청",
        "장군마을 민관협의체(7월) 요청사항에 대한 무응답 관련 신속한 검토결과 공유 촉구"
    ];

    const lhOpenings = [
        "공공택지 개발과 지역 상생을 위해 힘쓰시는 귀 공사(LH)의 노고에 감사드립니다. 아래와 같이 민원을 제출합니다.",
        "귀 공사(LH)의 공정하고 투명한 업무 처리를 신뢰합니다. 아래와 같이 민원을 제출합니다."
    ];

    const lhNotice = "지난 7월 개최된 민관협의체(사전회의)에서 귀 공사는 장군마을 주민들이 요청한 사항에 대해 검토를 진행하겠다고 약속하였습니다. 그러나 회의 이후 현재까지 중간 검토 결과 공유 등 어떠한 진행 상황 안내도 이루어지지 않아 검토 진행 과정을 확인하고 긍정적인 검토 결과를 이끌어내고자 이 민원을 제출합니다.";

    const lhReq1Variants = [
        "[요청 1] 민관협의체(7월) 요청사항에 대한 중간 검토 결과 공유\n\n장군마을 주민이 민관협의체(7월)를 통해 귀 공사에 요청한 사항에 대한 중간 검토 내용을 알려주시기 바랍니다. 저희가 요청한 사항은 미매각 업무시설용지의 허용용도 중 '데이터센터'의 삭제와, 매각 여부와 관계없이 업무시설용지에 업무시설을 주용도로 설정하는 것입니다.",
        "[요청 1] 데이터센터 허용용도 삭제 요청 건 중간 검토 결과 안내\n\n지난 7월 민관협의체를 통해 귀 공사에 요청드린 사항—미매각 업무시설용지의 허용용도 중 '데이터센터' 삭제 및 매각 여부와 관계없는 업무시설 주용도 설정—에 대한 중간 검토 내용을 안내해 주시기 바랍니다."
