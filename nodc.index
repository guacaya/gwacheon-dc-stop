    const lhReq3Variants = [
        "[요청 3] 신속하고 투명한 진행상황 공유 촉구\n\n주민과의 약속은 검토 착수만으로 끝나는 것이 아니라 그 결과를 성실히 공유하는 데까지 이어져야 합니다. 회의 이후 한 달이 넘도록 아무런 회신이 없는 상황은 주민들의 신뢰를 크게 저해하고 있습니다. 하루빨리 중간 검토 결과를 공유해 주시고 향후 처리 일정도 함께 안내해 주시기를 강력히 촉구합니다.",
        "[요청 3] 조속한 답변을 강력히 요청드립니다\n\n검토를 약속하신 지 이미 상당한 시간이 지났음에도 아무런 진행 상황 안내가 없는 것은 행정에 대한 신뢰를 무너뜨리는 일입니다. 주민들이 더 이상 불안 속에 기다리지 않도록 하루빨리 명확한 답변을 주시기를 강력히 요청드립니다."
    ];

    const lhClosings = [
        "본 민원은 귀 공사의 적법한 업무 수행을 방해하고자 하는 것이 아니라 이미 약속하신 사항에 대한 투명하고 신속한 이행을 요청드리는 주민의 정당한 요구입니다. 지연되는 시간만큼 주민들의 불안과 불신이 커지고 있는 만큼 조속한 회신을 부탁드립니다.\n\n감사합니다.",
        "적법한 절차를 존중하나 이미 하신 약속의 이행 여부조차 확인할 수 없는 현재 상황은 결코 가볍게 넘길 문제가 아닙니다. 주민들과의 신뢰 회복을 위해서라도 하루빨리 명확한 답변을 주시기를 요청드립니다.\n\n감사합니다."
    ];

    const lhStrongAskVariants = [
        "아울러 귀 공사께서는 위와 같은 사유들을 종합적으로 고려하시어 주암지구 지구단위계획상 해당 부지의 허용용도에서 데이터센터를 명시적으로 제외하는 지구계획 변경 절차를 조속히 검토하고 추진해 주시기 바랍니다.",
        "아울러 귀 공사께서는 앞서 말씀드린 여러 우려를 충분히 반영하시어 지구단위계획상 허용용도에서 데이터센터를 제외하는 방향으로 조속히 절차를 진행해 주시기를 강력히 요청드립니다."
    ];

    let stateL = {};
    function rerollLh() {
        stateL = {
            titleIdx: getRandomIndex(lhTitleVariants.length),
            openIdx: getRandomIndex(lhOpenings.length),
            req1Idx: getRandomIndex(lhReq1Variants.length),
            req3Idx: getRandomIndex(lhReq3Variants.length),
            closeIdx: getRandomIndex(lhClosings.length),
            reasonIdxs: pickReasonIndices(2),
            askIdx: getRandomIndex(lhStrongAskVariants.length),
            warnIdx: getRandomIndex(WARNING_VARIANTS.length)
        };
    }

    function buildLh() {
        const body = lhOpenings[stateL.openIdx] + "\n\n" + lhNotice + getPersonalParagraph()
            + "\n\n" + lhReq1Variants[stateL.req1Idx]
            + "\n\n" + lhReq2
            + "\n\n" + lhReq3Variants[stateL.req3Idx]
            + "\n\n" + buildReasonsBlock(stateL.reasonIdxs)
            + "\n\n" + lhStrongAskVariants[stateL.askIdx]
            + "\n\n" + WARNING_VARIANTS[stateL.warnIdx]
            + "\n\n" + lhClosings[stateL.closeIdx];
        return { title: lhTitleVariants[stateL.titleIdx], body };
    }

    /* ===================== 모드 ③ 국토교통부 민원 ===================== */
